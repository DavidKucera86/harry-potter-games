{
  "name": "harry-potter-games",
  "version": "1.5.0",
  "private": true,
  "scripts": {
    "build:html": "node scripts/build-html.mjs",
    "build:js": "node scripts/build-js.mjs",
    "build": "npm run build:html && npm run build:js",
    "verify:build": "node scripts/verify-build.mjs",
    "prepare": "simple-git-hooks",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tests.json",
    "pretest": "npm run build && npm run lint && npm run typecheck",
    "test": "vitest run && playwright test",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:production": "PLAYWRIGHT_TARGET=production playwright test",
    "test:docker": "node scripts/test-docker.mjs",
    "test:ui": "playwright test --ui",
    "docs:test-catalog": "npm run build && playwright test --reporter=./scripts/gwt-catalog-reporter.ts",
    "lint": "eslint src/ tests/",
    "audit": "npm audit --audit-level=high"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run verify:build && npm run lint && npm run typecheck"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "fast-check": "^4.9.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.11.2",
    "serve": "^14.2.4",
    "simple-git-hooks": "^2.12.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
